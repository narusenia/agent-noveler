#!/usr/bin/env bash
# noveler: agent-noveler の便利コマンド。`noveler help` で一覧。
# gum（PATH → このフォルダの bin/gum の順）があれば見た目を整え、無ければ素の echo/read で同じことをする。
# 答えは環境変数でも渡せる（--yes か NOVELER_YES=1 で聞かずに既定値を使う）:
#   NOVELER_PACK（文体パック）、NOVELER_MODE（ai|human）、NOVELER_WORK（作品のフォルダ名）、
#   NOVELER_TITLE（題）、NOVELER_AUTHOR（作者名）、NOVELER_SYUKI（syuki の呼び方。既定は PATH の syuki）、
#   NOVELER_LAYOUT（single|packages。--layout でも渡せる）、NOVELER_FLOW（full|standard|lite。--flow でも渡せる）
set -euo pipefail

# このファイルの実体の場所（~/.local/bin からのリンクをたどる）
self=$0
while [ -L "$self" ]; do
  l=$(readlink "$self")
  case $l in /*) self=$l ;; *) self=$(dirname "$self")/$l ;; esac
done
SRC=$(cd "$(dirname "$self")/.." && pwd)
SAMPLE=$SRC/examples/sample-work
GUM_VERSION=0.17.0
REPO_URL=$(git -C "$SRC" remote get-url origin 2>/dev/null || echo https://github.com/narusenia/agent-noveler)
SYUKI_SPEC="syuki[ja] @ git+$REPO_URL#subdirectory=packages/syuki"
read -r -a SYUKI <<<"${NOVELER_SYUKI:-syuki}"

# 道具の管理（install.sh が $SRC/config に書く）。mise なら node・pnpm・uv・gum を mise exec で揃えて動かす
MISE_TOOLS="node@22 pnpm@11 uv@latest gum@$GUM_VERSION"
TOOLS=${NOVELER_TOOLS:-$(sed -n 's/^tools=//p' "$SRC/config" 2>/dev/null || true)}
TOOLS=${TOOLS:-plain}
if [ "$TOOLS" = mise ] && [ -z "${NOVELER_IN_MISE:-}" ] && command -v mise >/dev/null; then
  # shellcheck disable=SC2086
  NOVELER_IN_MISE=1 exec mise exec $MISE_TOOLS -- "$self" "$@"
fi

YES=${NOVELER_YES:-}
HELP=
LAYOUT=${NOVELER_LAYOUT:-}
FLOW=${NOVELER_FLOW:-}
args=()
next=
for a in "$@"; do
  case $next in layout) LAYOUT=$a; next=; continue ;; flow) FLOW=$a; next=; continue ;; esac
  case $a in -y | --yes) YES=1 ;; -h | --help) HELP=1 ;; --layout) next=layout ;; --layout=*) LAYOUT=${a#*=} ;; --flow) next=flow ;; --flow=*) FLOW=${a#*=} ;; *) args+=("$a") ;; esac
done
set -- ${args[@]+"${args[@]}"}

GUM=
if [ -z "${NOVELER_NO_GUM:-}" ] && [ -t 1 ]; then
  if command -v gum >/dev/null; then GUM=gum; elif [ -x "$SRC/bin/gum" ]; then GUM=$SRC/bin/gum; fi
fi

# ---- 表示と入力 ----
title() { if [ -n "$GUM" ]; then "$GUM" style --bold --foreground 212 "$*"; else echo "== $* =="; fi; }
info() { if [ -n "$GUM" ]; then "$GUM" style --foreground 245 "$*"; else echo "$*"; fi; }
die() { echo "noveler: $*" >&2; exit 1; }

# ask <問い> <既定値> → 答えを標準出力に
ask() {
  if [ -n "$YES" ]; then echo "$2"; return; fi
  if [ -n "$GUM" ]; then "$GUM" input --header "$1" --value "$2" </dev/tty; return; fi
  local r
  read -r -p "$1 [$2]: " r </dev/tty
  echo "${r:-$2}"
}

# choose <問い> <既定値> <選択肢...>
choose() {
  local q=$1 d=$2
  shift 2
  if [ -n "$YES" ] || [ $# -eq 1 ]; then echo "$d"; return; fi
  if [ -n "$GUM" ]; then "$GUM" choose --header "$q" --selected "$d" "$@" </dev/tty; return; fi
  echo "$q ($*)" >&2
  local r
  read -r -p "> [$d]: " r </dev/tty
  echo "${r:-$d}"
}

# confirm <問い> → はいなら 0
confirm() {
  if [ -n "$YES" ]; then return 0; fi
  if [ -n "$GUM" ]; then "$GUM" confirm --default=false "$1" </dev/tty; return; fi
  local r
  read -r -p "$1 [y/N]: " r </dev/tty
  case $r in y | Y | yes) return 0 ;; *) return 1 ;; esac
}

# spin <見出し> <コマンド...>
spin() {
  local t=$1
  shift
  if [ -n "$GUM" ]; then "$GUM" spin --show-error --title "$t" -- "$@"; else echo "$t"; "$@"; fi
}

# ---- 原稿のリポジトリと作品 ----
# 今いる所から上へ、.agents/ のあるフォルダを探す
find_repo() {
  local d=$PWD
  while [ "$d" != / ]; do
    [ -d "$d/.agents" ] && { echo "$d"; return; }
    d=$(dirname "$d")
  done
  return 1
}
need_repo() { find_repo || die "Run this inside a manuscript repository (a folder with .agents/). To create one: noveler new"; }
# 作品 = manuscript/ を持つ直下のフォルダ
works() { local w; for w in "$1"/*/manuscript; do [ -d "$w" ] && basename "$(dirname "$w")"; done; return 0; }
# 作品が並ぶフォルダ: 直下に作品が無く packages/*/manuscript があれば packages/、それ以外はリポジトリの根
works_dir() { if [ -z "$(works "$1")" ] && [ -n "$(works "$1/packages")" ]; then echo "$1/packages"; else echo "$1"; fi; }
# packages 形: packages/ があるか、pnpm-workspace.yaml が packages/* を指す
is_packages() { [ -d "$1/packages" ] || grep -q 'packages/\*' "$1/pnpm-workspace.yaml" 2>/dev/null; }
pnpm_cmd() { if command -v pnpm >/dev/null; then pnpm "$@"; else npx -y pnpm@11 "$@"; fi; }

# ---- 道具 ----
# gum を GitHub Releases から落とし、checksums.txt で照合して $SRC/bin/gum に置く。失敗しても止めない
fetch_gum() {
  [ "$TOOLS" = mise ] && return 0
  command -v gum >/dev/null && return 0
  if [ -x "$SRC/bin/gum" ] && "$SRC/bin/gum" --version 2>/dev/null | grep -q "$GUM_VERSION"; then return 0; fi
  local os arch name base tmp sum want
  case $(uname -s) in Darwin) os=Darwin ;; Linux) os=Linux ;; *) echo "gum: unsupported OS, continuing with plain output"; return 0 ;; esac
  case $(uname -m) in arm64 | aarch64) arch=arm64 ;; x86_64 | amd64) arch=x86_64 ;; *) echo "gum: unsupported CPU, continuing with plain output"; return 0 ;; esac
  name=gum_${GUM_VERSION}_${os}_${arch}
  base=https://github.com/charmbracelet/gum/releases/download/v$GUM_VERSION
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/noveler-gum.XXXXXX")
  if curl -fsSL -o "$tmp/$name.tar.gz" "$base/$name.tar.gz" && curl -fsSL -o "$tmp/checksums.txt" "$base/checksums.txt"; then
    want=$(awk -v f="$name.tar.gz" '$2 == f { print $1 }' "$tmp/checksums.txt")
    if command -v sha256sum >/dev/null; then sum=$(sha256sum "$tmp/$name.tar.gz" | cut -d' ' -f1); else sum=$(shasum -a 256 "$tmp/$name.tar.gz" | cut -d' ' -f1); fi
    if [ -n "$want" ] && [ "$sum" = "$want" ] && tar -xzf "$tmp/$name.tar.gz" -C "$tmp" "$name/gum"; then
      mv "$tmp/$name/gum" "$SRC/bin/gum"
      echo "gum $GUM_VERSION: $SRC/bin/gum (sha256 verified)"
    else
      echo "gum: sha256 mismatch, continuing with plain output"
    fi
  else
    echo "gum: download failed, continuing with plain output"
  fi
  rm -rf "$tmp"
}

# install.sh と update から呼ぶ。gum・syuki・~/.local/bin/noveler を揃える
cmd_setup() {
  fetch_gum
  uv tool install --force "$SYUKI_SPEC"
  mkdir -p "$HOME/.local/bin"
  ln -sf "$SRC/bin/noveler" "$HOME/.local/bin/noveler"
  echo "link: ~/.local/bin/noveler -> $SRC/bin/noveler"
  case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) echo "~/.local/bin is not on PATH. Add export PATH=\"\$HOME/.local/bin:\$PATH\" to your shell config" ;; esac
}

# ---- サブコマンド ----
cmd_new() {
  local dir=${1:-}
  [ -n "$dir" ] || dir=$(ask "Folder for the manuscript repository" novels)
  mkdir -p "$dir"
  dir=$(cd "$dir" && pwd)
  title "Manuscript repository: $dir"
  [ -d "$dir/.git" ] || git -C "$dir" init -q
  if [ -d "$dir/.agents" ]; then
    info "Harness already installed (.agents/). To reinstall: noveler update"
  else
    local packs pack mode layout flow
    layout=${LAYOUT:-$(choose "Layout: single (works at the repo root) / packages (works under packages/, for several works)" single single packages)}
    case $layout in single | packages) ;; *) die "layout must be single or packages: $layout" ;; esac
    packs=$(cd "$SRC/harness/packs" && for f in */pack.toml; do echo "${f%/pack.toml}"; done)
    # shellcheck disable=SC2086
    pack=${NOVELER_PACK:-$(choose "Style pack" general $packs)}
    mode=${NOVELER_MODE:-$(choose "Writing mode (ai: AI writes, you review / human: you write, AI reviews)" ai ai human)}
    case $mode in ai | human) ;; *) die "mode must be ai or human: $mode" ;; esac
    flow=${FLOW:-$(choose "Chapter flow (standard: one combined review per chapter / full: every review step / lite: fewest steps, fewest tokens)" standard standard full lite)}
    case $flow in full | standard | lite) ;; *) die "flow must be full, standard or lite: $flow" ;; esac
    bash "$SRC/harness/scripts/install.sh" "$dir" "$pack"
    local r=$dir/.agents/roles.toml
    sed -e "s/^write = .*/write = \"$mode\"/" -e "s/^flow = .*/flow = \"$flow\"/" -e "s/^pack = .*/pack = \"$pack\"/" "$r" >"$r.tmp" && mv "$r.tmp" "$r"
    if [ "$layout" = packages ]; then
      # 雛形の AGENTS.md が書く作品の置き場所を packages/ に合わせる
      sed -e 's|例 `mywork/`|例 `packages/mywork/`|' -e 's|--work <作品>|--work packages/<作品>|g' "$dir/AGENTS.md" >"$dir/AGENTS.md.tmp" && mv "$dir/AGENTS.md.tmp" "$dir/AGENTS.md"
      [ -e "$dir/pnpm-workspace.yaml" ] || printf 'packages:\n  - "packages/*"\n' >"$dir/pnpm-workspace.yaml"
    fi
  fi
  [ -e "$dir/package.json" ] || printf '{\n  "name": "%s",\n  "private": true\n}\n' "$(basename "$dir" | tr -cs 'a-z0-9-' '-' | sed 's/^-*//; s/-*$//')" >"$dir/package.json"
  [ -e "$dir/pnpm-workspace.yaml" ] || printf 'packages:\n  - "*"\n' >"$dir/pnpm-workspace.yaml"
  [ -e "$dir/.gitignore" ] || printf 'node_modules/\n.DS_Store\n' >"$dir/.gitignore"
  if [ "$TOOLS" = mise ] && [ ! -e "$dir/mise.toml" ]; then
    printf '[tools]\nnode = "22"\npnpm = "11"\nuv = "latest"\ngum = "%s"\n' "$GUM_VERSION" >"$dir/mise.toml"
    (cd "$dir" && mise trust -q && spin "mise install" mise install node pnpm uv gum)
  fi
  (cd "$dir" && cmd_add "${NOVELER_WORK:-}")
  title "Created manuscript repo at $dir"
  local p=
  is_packages "$dir" && p=packages/
  info "Next: cd $dir, write ${p}<work>/manuscript/vol1/01.kym.txt, then run noveler open"
}

cmd_add() {
  local repo name t author w
  repo=$(need_repo)
  name=${1:-}
  [ -n "$name" ] || name=$(ask "Work folder name (letters, digits, - and _)" my-novel)
  case $name in "" | *[!A-Za-z0-9_-]*) die "Folder name may use only letters, digits, - and _: $name" ;; esac
  w=$repo/$name
  is_packages "$repo" && w=$repo/packages/$name
  [ -e "$w/book.config.js" ] && die "Already exists: $w"
  # 作品の package.json の名前はフォルダ名。ワークスペースの別の package.json と同じ名前なら止める
  local p
  for p in "$repo/package.json" "$repo"/*/package.json "$repo"/packages/*/package.json; do
    grep -qF "\"name\": \"$name\"" "$p" 2>/dev/null && die "Package name \"$name\" is already used by $p. Choose another folder name"
  done
  t=${NOVELER_TITLE:-$(ask "Title" "$name")}
  author=${NOVELER_AUTHOR:-$(ask "Author name" 作者)}
  title "Adding work: $name"
  "${SYUKI[@]}" init "$w"
  # 見本の形を写す（原稿と台帳は写さない）。題と作者名、出力の名前だけ差し替える
  esc() { local s=${1//\\/\\\\}; s=${s//\"/\\\"}; printf '%s' "$s"; }
  local cfg
  cfg=$(<"$SAMPLE/book.config.js")
  cfg=${cfg//\"灯台の鍵\"/\"$(esc "$t")\"}
  cfg=${cfg//\"見本\"/\"$(esc "$author")\"}
  printf '%s\n' "$cfg" >"$w/book.config.js"
  cp "$SAMPLE/vivliostyle.config.js" "$SAMPLE/.gitignore" "$w/"
  sed -e "s/\"sample-work\"/\"$name\"/" -e "s/sample-work_/${name}_/g" -e "s/\"description\": .*/\"description\": \"$(esc "$t" | sed 's/[&/\\]/\\&/g')\",/" \
    "$SAMPLE/package.json" >"$w/package.json"
  if ! grep -q '^title:' "$w/syuki.yml"; then
    { printf 'title: %s\n' "$t"; cat "$w/syuki.yml"; } >"$w/syuki.yml.tmp"
    mv "$w/syuki.yml.tmp" "$w/syuki.yml"
  fi
  info "Created work at $w (write chapters in manuscript/vol1/<chapter>.kym.txt)"
}

cmd_open() {
  local dir=${1:-}
  if [ -n "$dir" ]; then dir=$(cd "$dir" && pwd) || die "No such folder: $1"; else dir=$(works_dir "$(need_repo)"); fi
  # 原稿のリポジトリや $SRC の package.json（devEngines など）に npx・pnpm が引っかからないよう、中立のフォルダから起動する
  cd "${TMPDIR:-/tmp}"
  if command -v pnpm >/dev/null; then pnpm dlx @narusenia/shosai "$dir"; else npx -y @narusenia/shosai "$dir"; fi
}

cmd_build() {
  local repo wd work vol script=build ws=() a pos=()
  repo=$(need_repo)
  wd=$(works_dir "$repo")
  for a in "$@"; do case $a in --epub) script=build:epub ;; *) pos+=("$a") ;; esac; done
  work=${pos[0]:-}
  vol=${pos[1]:-vol1}
  if [ -z "$work" ]; then
    while IFS= read -r a; do ws+=("$a"); done < <(works "$wd")
    [ ${#ws[@]} -gt 0 ] || die "No works found. Add one with noveler add"
    work=$(choose "Which work to build" "${ws[0]}" "${ws[@]}")
  fi
  [ -f "$wd/$work/package.json" ] || die "No such work: $work"
  [ -d "$repo/node_modules" ] || (cd "$repo" && spin "Installing dependencies" pnpm_cmd install)
  (cd "$wd/$work" && VOL=$vol pnpm_cmd run "$script")
}

cmd_update() {
  title "Updating agent-noveler"
  if [ -d "$SRC/.git" ]; then spin "git pull" git -C "$SRC" pull --ff-only; fi
  cmd_setup
  local repo pack
  repo=$(find_repo) || return 0
  if [ "$TOOLS" = mise ] && [ -f "$repo/mise.toml" ]; then (cd "$repo" && spin "mise install" mise install node pnpm uv gum); fi
  pack=$(sed -n 's/^pack = "\(.*\)"/\1/p' "$repo/.agents/roles.toml" | head -1)
  if confirm "Reinstall $repo/.agents/ from the latest version? (Your edits outside roles.toml will be lost)"; then
    cp "$repo/.agents/roles.toml" "$repo/.roles.toml.bak"
    rm -rf "$repo/.agents"
    bash "$SRC/harness/scripts/install.sh" "$repo" "${pack:-general}"
    mv "$repo/.roles.toml.bak" "$repo/.agents/roles.toml"
  fi
}

cmd_doctor() {
  local t v repo wd w fail=0
  title "Tools (tool manager: ${TOOLS})"
  for t in git uv node pnpm gum syuki; do
    if [ $t = gum ] && ! command -v gum >/dev/null && [ -x "$SRC/bin/gum" ]; then v="$("$SRC/bin/gum" --version 2>&1 | head -1) ($SRC/bin/gum)"
    elif [ $t = syuki ] && [ -n "${NOVELER_SYUKI:-}" ]; then v="NOVELER_SYUKI=$NOVELER_SYUKI"
    elif command -v $t >/dev/null; then
      case $t in syuki) v=$(command -v syuki) ;; *) v=$($t --version 2>&1 | head -1 || true) ;; esac
    else v="missing"; fi
    printf '  %-6s %s\n' "$t" "$v"
  done
  printf '  %-6s %s\n' noveler "$SRC"
  repo=$(find_repo) || { info "Not in a manuscript repository, skipped syuki check"; return 0; }
  title "syuki check ($repo)"
  wd=$(works_dir "$repo")
  for w in $(works "$wd"); do
    [ -f "$wd/$w/syuki.yml" ] || continue
    if "${SYUKI[@]}" check --work "$wd/$w" >/dev/null 2>&1; then echo "  $w: ok"; else echo "  $w: issues found (details: syuki check --work $w)"; fail=1; fi
  done
  return $fail
}

cmd_help() {
  cat <<'EOF'
noveler — write novels with AI agents (agent-noveler)

  noveler new [folder]         Create a manuscript repository (git init, harness, first work)
      --layout single|packages   single: works at the repo root / packages: works under packages/
      --flow full|standard|lite  How many review steps each chapter goes through (default: standard)
  noveler add [work]           Add a work folder (syuki ledger, PDF config, manuscript/vol1/)
  noveler open [folder]        Open the works in the reading desk (shosai)
  noveler build [work] [vol]   Build a PDF (--epub for EPUB)
  noveler update               Update noveler and syuki, then reinstall .agents/ (asks first)
  noveler doctor               Show installed tools and versions, and syuki check results
  noveler help                 Show this help

  -y, --yes                    Use defaults without asking
EOF
}

[ -n "$HELP" ] && set -- help
case ${1:-help} in
  new | create-project) shift; cmd_new "$@" ;;
  add) shift; cmd_add "$@" ;;
  open) shift; cmd_open "$@" ;;
  build) shift; cmd_build "$@" ;;
  update) cmd_update ;;
  doctor) cmd_doctor ;;
  _setup) cmd_setup ;;
  help | -h | --help) cmd_help ;;
  *) cmd_help >&2; exit 2 ;;
esac
